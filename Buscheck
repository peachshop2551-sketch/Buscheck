    { id: "T-TRG", badge: "ตรัง", dest: "ตรัง สตูล", color: "bg-emerald-700", name: "หมอชิต 2 - ตรัง - สตูล", fare: 828, dur: "1,008 กม.", times: [1025], stops: [{name:"หมอชิต 2", lat:13.8131, lng:100.5488}, {name:"สายใต้ใหม่", lat:13.7806, lng:100.4228}, {name:"ห้วยยอด", lat:7.7891, lng:99.5982}, {name:"ตรัง", lat:7.5563, lng:99.6114}, {name:"ละงู", lat:6.8801, lng:99.7820}, {name:"สตูล", lat:6.6238, lng:100.0674}] },
    { id: "T-SKA", badge: "สงขลา", dest: "สงขลา", color: "bg-amber-600", name: "สายใต้ใหม่ - สงขลา", fare: 824, dur: "1,004 กม.", times: [960], stops: [{name:"สายใต้ใหม่", lat:13.7806, lng:100.4228}, {name:"สุราษฎร์ธานี", lat:9.1382, lng:99.3217}, {name:"นครศรีธรรมราช", lat:8.4304, lng:99.9631}, {name:"สงขลา", lat:7.1988, lng:100.5951}] },
    { id: "T-SGK", badge: "โกลก", dest: "สุไหงโกลก นราธิวาส ปัตตานี", color: "bg-teal-700", name: "สายใต้ใหม่ - สุไหงโกลก", fare: 1001, dur: "1,227 กม.", times: [930], stops: [{name:"สายใต้ใหม่", lat:13.7806, lng:100.4228}, {name:"ปัตตานี", lat:6.8661, lng:101.2502}, {name:"นราธิวาส", lat:6.4255, lng:101.8253}, {name:"สุไหงโกลก", lat:6.0270, lng:101.9660}] }
  ];
  const allRoutes = [...busRoutes, ...tourRoutes];

  let mode = 'city', prov = 'กรุงเทพฯ';
  const provs = ['กรุงเทพฯ', 'เชียงใหม่', 'ขอนแก่น', 'ภูเก็ต'];
  const chip = (on, fn, label) => `<button onclick="${fn}" class="px-3 py-1.5 rounded-full text-xs whitespace-nowrap border ${on ? 'bg-blue-600 border-blue-600 text-white' : 'bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300'}">${label}</button>`;
  function renderFilters() {
    document.getElementById('filters').innerHTML =
      `<div class="flex gap-2">${chip(mode === 'city', "setMode('city')", 'รถในเมือง')}${chip(mode === 'tour', "setMode('tour')", 'รถทัวร์ต่างจังหวัด')}</div>` +
      (mode === 'city' ? `<div class="flex gap-2 overflow-x-auto pb-1">${provs.map(p => chip(p === prov, `setProv('${p}')`, p)).join('')}</div>` : '');
  }
  function setMode(m) { mode = m; renderFilters(); filterBusRoutes(); }
  function setProv(p) { prov = p; renderFilters(); filterBusRoutes(); }

  const sunSvg = '<svg class="ico" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>';
  const moonSvg = '<svg class="ico" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>';
  const clockSvg = '<svg class="ico" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>';

  function bkkNow() {
    const n = new Date();
    return new Date(n.getTime() + (n.getTimezoneOffset() + 420) * 60000);
  }
  const pad = n => String(n).padStart(2, '0');
  const fmt = m => `${pad(Math.floor(m / 60) % 24)}:${pad(m % 60)} น.`;

  function nextBus(bus) {
    const t = bkkNow();
    const nowSec = t.getHours() * 3600 + t.getMinutes() * 60 + t.getSeconds();
    if (bus.times) { const n = bus.times.map(m => m * 60).find(x => x >= nowSec); return n === undefined ? { state: 'ended' } : { state: 'run', sec: n - nowSec }; }
    const firstSec = bus.fm * 60, lastSec = bus.lm * 60;
    if (nowSec < firstSec) return { state: 'before', sec: firstSec - nowSec };
    if (nowSec > lastSec) return { state: 'ended' };
    const k = Math.ceil((nowSec - firstSec) / (bus.iv * 60));
    const nextSec = firstSec + k * bus.iv * 60;
    if (nextSec > lastSec) return { state: 'ended' };
    return { state: 'run', sec: nextSec - nowSec };
  }

  function countdownText(bus, long) {
    const r = nextBus(bus);
    if (r.state === 'ended') return `<span class="text-slate-400">หมดรอบวิ่งแล้ววันนี้</span>`;
    const min = Math.floor(r.sec / 60), s = r.sec % 60;
    if (r.state === 'before') {
      const h = Math.floor(min / 60), m = min % 60;
      return `<span class="text-slate-500 dark:text-slate-400">รถเที่ยวแรกออกในอีก ${h > 0 ? h + ' ชม. ' : ''}${m} นาที</span>`;
    }
    if (!long) return `<span class="text-green-600 dark:text-green-400 font-medium">อีก ${min >= 60 ? Math.floor(min / 60) + ' ชม. ' + (min % 60) : (min < 1 ? 'ไม่ถึง 1' : min)} นาที</span>`;
    return `<p class="text-xs text-slate-500 dark:text-slate-400">รถคันถัดไปจะมาถึงในอีก</p>
      <p class="text-3xl font-semibold text-blue-600 dark:text-blue-400 tabular-nums">${min >= 60 ? Math.floor(min / 60) + ' <span class="text-base font-normal">ชม.</span> ' + (min % 60) : min} <span class="text-base font-normal">นาที</span> ${pad(s)} <span class="text-base font-normal">วิ</span></p>`;
  }

  let currentId = null;

  function renderRoutes(routes) {
    const c = document.getElementById('routeList');
    if (!routes.length) { c.innerHTML = `<p class="text-center text-slate-400 py-8 text-sm">ไม่พบข้อมูลสายรถเมล์</p>`; return; }
    c.innerHTML = routes.map(b => `
      <div onclick="openModal('${b.id}')" class="bg-white dark:bg-slate-800 p-4 rounded-xl shadow-sm border border-slate-100 dark:border-slate-700 cursor-pointer hover:border-blue-300 dark:hover:border-blue-500 transition flex items-center justify-between gap-2">
        <div class="flex items-center gap-3 min-w-0">
          <span class="${b.color} text-white font-bold w-12 h-12 shrink-0 rounded-xl flex items-center justify-center ${b.badge ? 'text-xs' : 'text-lg'} shadow-sm">${b.badge || b.id}</span>
          <div class="min-w-0">
            <h2 class="font-bold text-slate-800 dark:text-slate-100 text-sm">${b.name}</h2>
            <p class="text-xs text-slate-400 mt-0.5">${clockSvg} ${b.times ? b.dur + ' · ' + b.times.length + ' รอบ/วัน' : fmt(b.fm) + ' - ' + fmt(b.lm)}</p>
          </div>
        </div>
        <div class="text-right shrink-0 text-xs">
          <span class="bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-400 font-medium px-2 py-1 rounded-md">${b.times ? 'เริ่ม ฿' + b.fare : 'ทุก ' + b.iv + ' นาที'}</span>
          <p class="mt-1.5" data-cd="${b.id}"></p>
        </div>
      </div>`).join('');
    tick();
  }

  function filterBusRoutes() {
    const q = document.getElementById('searchInput').value.toLowerCase().trim();
    const pool = mode === 'city' ? busRoutes.filter(b => b.prov === prov) : tourRoutes;
    renderRoutes(pool.filter(b => b.id.toLowerCase().includes(q) || b.name.toLowerCase().includes(q) || (b.dest || '').includes(q)));
  }

  function openModal(id) {
    const b = allRoutes.find(x => x.id === id);
    if (!b) return;
    currentId = id;
    const badge = document.getElementById('modalBusBadge');
    badge.className = `${b.color} px-3 py-1 text-white font-bold text-lg rounded-lg`;
    badge.innerText = b.times ? `ไป${b.dest}` : `สาย ${b.id}`;
    document.getElementById('modalBusName').innerText = b.name;
    const T = !!b.times;
    document.getElementById('lbl1').innerText = T ? 'รอบแรก' : 'เที่ยวแรก';
    document.getElementById('lbl2').innerText = T ? 'รอบสุดท้าย' : 'เที่ยวสุดท้าย';
    document.getElementById('lbl3').innerText = T ? 'ราคา' : 'ความถี่';
    document.getElementById('modalFirstTime').innerText = fmt(T ? b.times[0] : b.fm);
    document.getElementById('modalLastTime').innerText = fmt(T ? b.times[b.times.length - 1] : b.lm);
    document.getElementById('modalInterval').innerText = T ? `฿${b.fare}${b.fareMax ? '–' + b.fareMax : ''}` : `ทุก ${b.iv} นาที`;
    document.getElementById('modalTimesWrap').classList.toggle('hidden', !T);
    if (T) document.getElementById('modalTimes').innerHTML = b.times.map(m => `<span class="px-2 py-1 rounded-md bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 tabular-nums">${fmt(m).replace(' น.', '')}</span>`).join('');
    
    // แสดงป้ายรถพร้อม พิกัด (Lat, Lng) และปุ่มเปิดแผนที่ Google Maps
    document.getElementById('modalStops').innerHTML = b.stops.map((s, i) => {
      const end = i === 0 || i === b.stops.length - 1;
      const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${s.lat},${s.lng}`;
      return `<div class="relative pl-3 flex justify-between items-start">
        <div>
          <div class="absolute -left-[21px] top-1.5 w-2.5 h-2.5 rounded-full ${end ? 'bg-blue-600 ring-4 ring-blue-100 dark:ring-blue-900' : 'bg-slate-300 dark:bg-slate-600'}"></div>
          <p class="${end ? 'font-semibold text-slate-800 dark:text-slate-100' : 'text-slate-600 dark:text-slate-400'}">${s.name}</p>
          <p class="text-[10px] text-slate-400 font-mono">พิกัด: ${s.lat}, ${s.lng}</p>
        </div>
        <a href="${mapsUrl}" target="_blank" class="text-xs text-blue-600 dark:text-blue-400 hover:underline shrink-0 bg-blue-50 dark:bg-blue-950 px-2 py-1 rounded-md">เปิดแผนที่</a>
      </div>`;
    }).join('');

    document.getElementById('detailModal').classList.remove('hidden');
    tick();
  }

  function closeModal() {
    document.getElementById('detailModal').classList.add('hidden');
    currentId = null;
  }

  function tick() {
    const t = bkkNow();
    document.getElementById('clock').innerText = `${pad(t.getHours())}:${pad(t.getMinutes())}:${pad(t.getSeconds())} น.`;
    document.querySelectorAll('[data-cd]').forEach(el => {
      const b = allRoutes.find(x => x.id === el.dataset.cd);
      if (b) el.innerHTML = countdownText(b, false);
    });
    if (currentId) {
      const b = allRoutes.find(x => x.id === currentId);
      if (b) document.getElementById('modalNext').innerHTML = countdownText(b, true);
    }
  }

  function applyTheme(dark) {
    document.documentElement.classList.toggle('dark', dark);
    document.getElementById('darkIcon').innerHTML = dark ? sunSvg : moonSvg;
    document.getElementById('darkText').innerText = dark ? 'โหมดสว่าง' : 'โหมดมืด';
  }

  function toggleDarkMode() {
    const dark = !document.documentElement.classList.contains('dark');
    applyTheme(dark);
    try { localStorage.setItem('bus-theme', dark ? 'dark' : 'light'); } catch (e) {}
  }

  (function init() {
    let saved = null;
    try { saved = localStorage.getItem('bus-theme'); } catch (e) {}
    const dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
    applyTheme(dark);
    renderFilters();
    filterBusRoutes();
    getUserLocation(); // เรียกดึงพิกัดผู้ใช้อัตโนมัติเมื่อเปิดเว็บ
    setInterval(tick, 1000);
  })();
</script>
</body>
</html>
