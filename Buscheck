  function getUserLocation() {
    const el = document.getElementById('userCoords');
    if (!navigator.geolocation) {
      el.innerText = 'อุปกรณ์ไม่รองรับการระบุพิกัด GPS';
      return;
    }
    el.innerText = 'กำลังค้นหาตำแหน่ง...';
    navigator.geolocation.getCurrentPosition(
      pos => {
        userLat = pos.coords.latitude;
        userLng = pos.coords.longitude;
        el.innerText = `${userLat.toFixed(4)}, ${userLng.toFixed(4)}`;
      },
      err => {
        el.innerText = 'ไม่สามารถดึงพิกัดได้ (กรุณาเปิด GPS)';
      }
    );
  }

